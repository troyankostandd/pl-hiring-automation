<div class="min-h-screen flex flex-col justify-center items-center bg-white px-6">
  <div class="max-w-2xl w-full">
    <h1 class="text-6xl font-bold mb-8 text-center">Cook from what you already have.</h1>

    <form action="<%= recipes_path %>" method="get" class="mb-8">
      <div class="mb-6">
        <input
          type="text"
          name="ingredients"
          placeholder="Add an ingredient..."
          class="w-full px-4 py-3 border border-gray-300 rounded"
          autofocus
        >
      </div>

      <button type="submit" class="w-full bg-green-700 text-white py-3 rounded font-semibold">
        Find recipes
      </button>
    </form>

    <div class="text-center text-gray-600">
      <p><%= @recipe_count %> recipes ready</p>
    </div>
  </div>
</div>
