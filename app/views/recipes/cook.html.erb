<div class="min-h-screen bg-white">
  <div class="max-w-2xl mx-auto p-6">
    <a href="<%= recipe_path(@recipe.slug) %>" class="text-blue-600 mb-8 inline-block">← Back</a>

    <h1 class="text-3xl font-bold mb-8"><%= @recipe.title %></h1>

    <div class="space-y-6">
      <% if @recipe.instructions.present? %>
        <ol class="space-y-6 list-decimal list-inside">
          <% @recipe.instructions.split("\n\n").each_with_index do |instruction, index| %>
            <li class="text-lg leading-relaxed">
              <%= instruction.strip %>
            </li>
          <% end %>
        </ol>
      <% end %>
    </div>
  </div>
</div>
