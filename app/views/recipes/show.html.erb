<div class="min-h-screen bg-white">
  <div class="max-w-3xl mx-auto px-6 py-6">
    <a href="<%= back_to_results_url %>" class="inline-block text-sm text-brand hover:underline mb-6">← Back to results</a>

    <!-- Header (Allrecipes-style: eyebrow category, big title, rating) -->
    <% if @recipe.category.present? %>
      <p class="text-xs font-bold tracking-widest uppercase text-brand mb-2"><%= @recipe.category %></p>
    <% end %>

    <h1 class="text-4xl md:text-5xl font-bold font-display text-ink leading-tight mb-4"><%= @recipe.title %></h1>

    <% if @recipe.ratings.present? %>
      <div class="flex items-center gap-2 mb-6">
        <span class="text-amber-500 text-xl tracking-tight" aria-hidden="true"><%= star_rating(@recipe.ratings) %></span>
        <span class="text-sm font-semibold text-ink"><%= @recipe.ratings %></span>
        <span class="text-sm text-gray-500">(<%= @recipe.ratings %> out of 5)</span>
      </div>
    <% end %>

    <% if @recipe.description.present? %>
      <p class="text-gray-700 mb-6 leading-relaxed"><%= @recipe.description %></p>
    <% end %>

    <!-- Hero image -->
    <% if @recipe.image_url.present? %>
      <img src="<%= @recipe.image_url %>" alt="<%= @recipe.title %>" class="w-full h-80 object-cover rounded-lg mb-8">
    <% end %>

    <!-- Stats strip -->
    <div class="grid grid-cols-2 sm:grid-cols-4 border-y border-gray-200 divide-x divide-gray-200 mb-10">
      <div class="px-4 py-4 text-center">
        <p class="text-xs font-bold uppercase tracking-wide text-gray-500">Prep Time</p>
        <p class="text-sm font-semibold text-ink mt-1"><%= @recipe.prep_time_minutes.to_i > 0 ? "#{@recipe.prep_time_minutes} mins" : "—" %></p>
      </div>
      <div class="px-4 py-4 text-center">
        <p class="text-xs font-bold uppercase tracking-wide text-gray-500">Cook Time</p>
        <p class="text-sm font-semibold text-ink mt-1"><%= @recipe.cook_time_minutes.to_i > 0 ? "#{@recipe.cook_time_minutes} mins" : "—" %></p>
      </div>
      <div class="px-4 py-4 text-center">
        <p class="text-xs font-bold uppercase tracking-wide text-gray-500">Total Time</p>
        <p class="text-sm font-semibold text-ink mt-1"><%= @recipe.total_time_minutes.to_i > 0 ? "#{@recipe.total_time_minutes} mins" : "—" %></p>
      </div>
      <div class="px-4 py-4 text-center">
        <p class="text-xs font-bold uppercase tracking-wide text-gray-500">Servings</p>
        <p class="text-sm font-semibold text-ink mt-1"><%= @recipe.yields.presence || "—" %></p>
      </div>
    </div>

    <!-- Ingredients -->
    <section class="mb-10">
      <h2 class="text-2xl font-bold font-display text-ink mb-4">Ingredients</h2>
      <ul class="space-y-3">
        <% @recipe.recipe_ingredients.each do |ri| %>
          <li>
            <label class="flex items-start gap-3 cursor-pointer group">
              <input type="checkbox" class="peer mt-1 h-4 w-4 accent-brand shrink-0">
              <span class="text-ink peer-checked:line-through peer-checked:text-gray-400">
                <%= ri.original_text.presence || "#{ri.quantity} #{ri.unit} #{ri.ingredient.display_name || ri.ingredient.name}".squish %>
              </span>
            </label>
          </li>
        <% end %>
      </ul>
    </section>

    <!-- Directions -->
    <section class="mb-10">
      <h2 class="text-2xl font-bold font-display text-ink mb-4">Directions</h2>
      <% if @recipe.instructions.present? %>
        <ol class="space-y-6">
          <% @recipe.instructions.split("\n\n").each_with_index do |instruction, i| %>
            <li class="flex gap-4">
              <span class="font-bold text-brand">Step <%= i + 1 %></span>
              <p class="text-ink leading-relaxed"><%= instruction.strip %></p>
            </li>
          <% end %>
        </ol>
      <% else %>
        <div class="bg-gray-50 border border-gray-200 rounded-lg p-5">
          <p class="text-gray-700">
            Step-by-step directions aren't included in this dataset.
            <a href="<%= allrecipes_url(@recipe) %>" target="_blank" rel="noopener" class="text-brand font-semibold hover:underline">
              View the full recipe on Allrecipes ↗
            </a>
          </p>
        </div>
      <% end %>
    </section>

    <div class="pt-6 border-t border-gray-200">
      <p class="text-sm text-gray-600">
        <a href="<%= allrecipes_url(@recipe) %>" target="_blank" rel="noopener" class="text-brand font-semibold hover:underline">View the full recipe on Allrecipes ↗</a>
      </p>
    </div>
  </div>
</div>
